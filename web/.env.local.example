# Copy to .env.local and fill in your Supabase project values (Project Settings -> API).
# NEXT_PUBLIC_ variables are inlined into the client bundle, so only ever
# put the anon/publishable key here, never the service role key.
# Same Supabase project as the Expo app — see the repo root .env.example.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
